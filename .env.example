PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Resend (aviso por email de pedidos/consultas/mensajes nuevos). Crea una
# cuenta gratuita en https://resend.com, ve a API Keys > Create API Key y
# pega el valor aquí. Mientras esté vacía, el sitio sigue funcionando con
# normalidad: solo se deja de enviar el email de aviso (los datos se
# siguen guardando en Supabase igualmente). Ver README para más detalle.
RESEND_API_KEY=
NOTIFICATION_EMAIL=somos.hamy@gmail.com

# Supabase service_role key (Project Settings > API > service_role secret,
# NO la anon key). Solo la usan rutas de servidor para leer/actualizar
# pedidos saltándose RLS (crear el pago y el webhook de Stripe). No lleva
# prefijo PUBLIC_: nunca llega al navegador. Ver README para más detalle.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (pago online real con tarjeta). Crea una cuenta en https://stripe.com,
# quédate en modo de pruebas y copia las claves desde Developers > API keys.
# Ver README para cómo configurar también el webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
