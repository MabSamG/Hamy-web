---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Only set on product detail pages — used to log a "producto_vista" analytics event. */
  productoSlug?: string;
}

const {
  title,
  description = "Hamy — artesanía y recuerdos únicos hechos a mano en resina: llaveros, marcapáginas, decoración y regalos personalizados.",
  productoSlug,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Quicksand:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Hamy</title>
  </head>
  <body class="flex min-h-screen flex-col" data-producto-slug={productoSlug}>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { trackPageView } from "../lib/analytics";

  const path = window.location.pathname;
  if (!path.startsWith("/admin")) {
    const productoSlug = document.body.dataset.productoSlug ?? null;
    trackPageView(path, productoSlug);
  }
</script>
