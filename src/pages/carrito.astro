---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carrito" description="Revisa tu pedido personalizado antes de confirmarlo.">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <h1 class="font-heading text-4xl font-bold text-hamy-brown">Tu carrito</h1>

    <div id="cart-empty" class="mt-10 hidden text-center">
      <span class="text-5xl" aria-hidden="true">🛒</span>
      <p class="mt-4 text-hamy-brown-light">Tu carrito está vacío.</p>
      <a href="/productos" class="btn-primary mt-6 inline-flex">Ver productos</a>
    </div>

    <div id="cart-load-error" class="mt-10 hidden rounded-3xl bg-red-50 p-6 text-center text-red-600">
      <p class="font-semibold">No se pudo cargar tu carrito.</p>
      <p class="mt-1 text-sm">
        Prueba a recargar la página. Si sigue sin funcionar, es posible que tu navegador tenga bloqueado el
        almacenamiento local (modo incógnito, o ajustes de privacidad).
      </p>
    </div>

    <div id="cart-content" class="mt-10 hidden grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <ul id="cart-items" class="space-y-4"></ul>

      <div class="h-fit rounded-3xl bg-white p-6 shadow-sm ring-1 ring-hamy-pink-light/20">
        <h2 class="font-heading text-xl font-bold text-hamy-brown">Resumen</h2>
        <div class="mt-4 flex items-center justify-between text-sm text-hamy-brown-light">
          <span>Artículos</span>
          <span id="cart-count">0</span>
        </div>
        <div class="mt-2 flex items-center justify-between text-sm text-hamy-brown-light">
          <span>Subtotal</span>
          <span id="cart-subtotal">0,00 €</span>
        </div>
        <div class="mt-1 flex items-center justify-between text-xs text-hamy-brown-light">
          <span>Peso del pedido</span>
          <span id="cart-weight">0 g</span>
        </div>
        <div class="mt-1 flex items-center justify-between text-sm text-hamy-brown-light">
          <span>Envío</span>
          <span id="cart-shipping">0,00 €</span>
        </div>
        <div class="mt-2 flex items-center justify-between text-lg font-bold text-hamy-brown">
          <span>Total</span>
          <span id="cart-total">0,00 €</span>
        </div>

        <form id="checkout-form" class="mt-6 space-y-3 border-t border-hamy-pink-light/20 pt-5" novalidate>
          <div>
            <label for="cliente-nombre" class="block text-sm font-semibold text-hamy-brown">Nombre *</label>
            <input
              id="cliente-nombre"
              type="text"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
          <div>
            <label for="cliente-email" class="block text-sm font-semibold text-hamy-brown">Email *</label>
            <input
              id="cliente-email"
              type="email"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
          <div>
            <label for="cliente-telefono" class="block text-sm font-semibold text-hamy-brown">Teléfono *</label>
            <input
              id="cliente-telefono"
              type="tel"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-hamy-brown">Entrega *</label>
            <div id="zona-envio-opciones" class="mt-1 space-y-2"></div>
          </div>
          <div id="direccion-wrap">
            <label for="cliente-direccion" class="block text-sm font-semibold text-hamy-brown">Dirección de envío *</label>
            <textarea
              id="cliente-direccion"
              rows="2"
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            ></textarea>
          </div>
          <p id="recogida-aviso" class="hidden rounded-xl bg-hamy-cream-dark/60 px-3 py-2 text-xs text-hamy-brown-light">
            Sin dirección de envío — te avisaremos por email o teléfono en cuanto tu pedido esté listo para recoger en Elche.
          </p>
          <p id="envio-excedido-aviso" class="hidden rounded-xl bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-700">
            Tu pedido supera el peso que cubrimos con tarifa automática (2 kg). Contáctanos directamente para
            consultar el coste de envío de pedidos grandes antes de confirmar.
          </p>
          <div>
            <label for="cliente-notas" class="block text-sm font-semibold text-hamy-brown">Notas (opcional)</label>
            <textarea
              id="cliente-notas"
              rows="2"
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            ></textarea>
          </div>

          <p id="checkout-error" class="hidden text-sm font-semibold text-red-500"></p>

          <button type="submit" id="checkout-submit" class="btn-primary w-full justify-center">Pagar ahora</button>
          <p class="text-xs text-hamy-brown-light">
            Al confirmar te llevaremos a la pasarela de pago segura de Stripe. Tu pedido queda guardado antes de pagar,
            así que si cierras esa pantalla puedes volver aquí y reintentarlo.
          </p>
        </form>
      </div>
    </div>

    <div id="cart-cancel-notice" class="mt-6 hidden rounded-2xl bg-amber-50 p-4 text-center text-sm font-semibold text-amber-700">
      Has cancelado el pago. Tu pedido sigue en el carrito, puedes revisarlo e intentarlo de nuevo cuando quieras.
    </div>
  </section>
</Layout>

<script>
  import { getCart, removeFromCart, type CartItem } from "../lib/cart";
  import { formatPrice } from "../data/products";
  import { supabase } from "../lib/supabase";
  import { ZONAS_ENVIO, calcularEnvio, PESO_EMBALAJE_GRAMOS, type ZonaEnvio } from "../data/shipping";

  const emptyEl = document.getElementById("cart-empty");
  const loadErrorEl = document.getElementById("cart-load-error");
  const contentEl = document.getElementById("cart-content");
  const cancelNoticeEl = document.getElementById("cart-cancel-notice");
  const itemsList = document.getElementById("cart-items");
  const countEl = document.getElementById("cart-count");
  const subtotalEl = document.getElementById("cart-subtotal");
  const weightEl = document.getElementById("cart-weight");
  const shippingEl = document.getElementById("cart-shipping");
  const totalEl = document.getElementById("cart-total");
  const zonaOpcionesEl = document.getElementById("zona-envio-opciones");
  const direccionWrap = document.getElementById("direccion-wrap");
  const direccionInput = document.getElementById("cliente-direccion") as HTMLTextAreaElement | null;
  const recogidaAviso = document.getElementById("recogida-aviso");
  const excedidoAviso = document.getElementById("envio-excedido-aviso");
  const checkoutForm = document.getElementById("checkout-form") as HTMLFormElement | null;
  const checkoutError = document.getElementById("checkout-error");
  const checkoutSubmit = document.getElementById("checkout-submit") as HTMLButtonElement | null;

  let currentItems: CartItem[] = [];

  function getSelectedZona(): ZonaEnvio {
    const checked = zonaOpcionesEl?.querySelector<HTMLInputElement>('input[name="zona-envio"]:checked');
    return (checked?.value as ZonaEnvio) ?? ZONAS_ENVIO[0].value;
  }

  function getPesoTotalGramos(): number {
    return currentItems.reduce((sum, item) => sum + (item.weightGrams || 0), 0) + PESO_EMBALAJE_GRAMOS;
  }

  function renderZonaOpciones() {
    if (!zonaOpcionesEl) return;
    zonaOpcionesEl.innerHTML = "";
    ZONAS_ENVIO.forEach((opcion, i) => {
      const label = document.createElement("label");
      label.className =
        "flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown has-[:checked]:border-hamy-coral has-[:checked]:bg-white";

      const left = document.createElement("span");
      left.className = "flex items-center gap-2";
      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = "zona-envio";
      radio.value = opcion.value;
      radio.className = "accent-hamy-coral";
      if (i === 0) radio.checked = true;
      radio.addEventListener("change", () => {
        updateDireccionVisibility();
        updateTotals();
      });
      const text = document.createElement("span");
      text.textContent = opcion.label;
      left.append(radio, text);

      const price = document.createElement("span");
      price.className = "zona-precio font-semibold";
      price.dataset.zona = opcion.value;

      label.append(left, price);
      zonaOpcionesEl.appendChild(label);
    });
  }

  function updateZonaPrecios() {
    if (!zonaOpcionesEl) return;
    const peso = getPesoTotalGramos();
    zonaOpcionesEl.querySelectorAll<HTMLElement>(".zona-precio").forEach((el) => {
      const zona = el.dataset.zona as ZonaEnvio;
      const calculo = calcularEnvio(zona, peso);
      el.textContent = !calculo.ok ? "Consultar" : calculo.priceCents === 0 ? "Gratis" : formatPrice(calculo.priceCents);
    });
  }

  function updateDireccionVisibility() {
    const isRecogida = getSelectedZona() === "recogida";
    direccionWrap?.classList.toggle("hidden", isRecogida);
    recogidaAviso?.classList.toggle("hidden", !isRecogida);
    if (direccionInput) direccionInput.required = !isRecogida;
  }

  function updateTotals() {
    const subtotal = currentItems.reduce((sum, item) => sum + item.priceCents, 0);
    const peso = getPesoTotalGramos();
    const zona = getSelectedZona();
    const calculo = calcularEnvio(zona, peso);

    updateZonaPrecios();
    if (weightEl) weightEl.textContent = `${peso} g`;
    if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal);

    const excedido = !calculo.ok;
    excedidoAviso?.classList.toggle("hidden", !excedido);
    if (checkoutSubmit) checkoutSubmit.disabled = excedido;

    if (excedido) {
      if (shippingEl) shippingEl.textContent = "—";
      if (totalEl) totalEl.textContent = "—";
      return;
    }

    const envio = calculo.priceCents;
    if (shippingEl) shippingEl.textContent = envio === 0 ? "Gratis" : formatPrice(envio);
    if (totalEl) totalEl.textContent = formatPrice(subtotal + envio);
  }

  function findFirstPhoto(item: CartItem): File | null {
    for (const group of Object.values(item.personalization ?? {})) {
      for (const field of Object.values(group.fields ?? {})) {
        if (field.value instanceof File) return field.value;
      }
    }
    return null;
  }

  function renderItem(item: CartItem): HTMLElement {
    const li = document.createElement("li");
    li.className = "flex gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-hamy-pink-light/20";

    const thumb = document.createElement("div");
    thumb.className =
      "flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-hamy-pink/15 via-hamy-coral/15 to-hamy-orange/15 text-3xl";
    const photo = findFirstPhoto(item);
    if (photo) {
      const img = document.createElement("img");
      img.className = "h-full w-full object-cover";
      img.alt = "";
      img.src = URL.createObjectURL(photo);
      thumb.appendChild(img);
    } else {
      thumb.textContent = item.emoji;
    }

    const info = document.createElement("div");
    info.className = "min-w-0 flex-1";

    const header = document.createElement("div");
    header.className = "flex items-start justify-between gap-2";
    const title = document.createElement("p");
    title.className = "font-heading text-lg font-bold text-hamy-brown";
    title.textContent = item.productName;
    const price = document.createElement("p");
    price.className = "shrink-0 font-semibold text-hamy-coral";
    price.textContent = formatPrice(item.priceCents);
    header.append(title, price);

    const details = document.createElement("ul");
    details.className = "mt-1 space-y-0.5 text-xs text-hamy-brown-light";
    for (const group of Object.values(item.personalization ?? {})) {
      for (const field of Object.values(group.fields ?? {})) {
        const detailItem = document.createElement("li");
        const value = field.value instanceof File ? field.value.name : field.value || "(sin especificar)";
        detailItem.textContent = `${group.groupLabel} · ${field.label}: ${value}`;
        details.appendChild(detailItem);
      }
    }

    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "mt-2 text-xs font-semibold text-red-500 hover:underline";
    removeBtn.textContent = "Quitar";
    removeBtn.addEventListener("click", async () => {
      await removeFromCart(item.id);
      await loadCart();
    });

    info.append(header, details, removeBtn);
    li.append(thumb, info);
    return li;
  }

  async function loadCart() {
    try {
      currentItems = await getCart();
    } catch (err) {
      console.error("No se pudo abrir el carrito (IndexedDB):", err);
      emptyEl?.classList.add("hidden");
      contentEl?.classList.add("hidden");
      loadErrorEl?.classList.remove("hidden");
      return;
    }

    if (currentItems.length === 0) {
      emptyEl?.classList.remove("hidden");
      loadErrorEl?.classList.add("hidden");
      contentEl?.classList.add("hidden");
      return;
    }

    emptyEl?.classList.add("hidden");
    loadErrorEl?.classList.add("hidden");
    contentEl?.classList.remove("hidden");

    if (itemsList) {
      itemsList.innerHTML = "";
      currentItems.forEach((item) => {
        try {
          itemsList.appendChild(renderItem(item));
        } catch (err) {
          console.error("No se pudo mostrar un artículo del carrito:", item, err);
          const li = document.createElement("li");
          li.className = "rounded-2xl bg-red-50 p-4 text-sm text-red-600";
          li.textContent = "Uno de los artículos del carrito no se pudo mostrar (dato dañado). Quítalo y vuelve a añadirlo.";
          itemsList.appendChild(li);
        }
      });
    }

    if (countEl) countEl.textContent = String(currentItems.length);
    updateTotals();
  }

  function showCheckoutError(message: string) {
    if (!checkoutError) return;
    checkoutError.textContent = message;
    checkoutError.classList.remove("hidden");
  }

  function clearCheckoutError() {
    checkoutError?.classList.add("hidden");
    if (checkoutError) checkoutError.textContent = "";
  }

  checkoutForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearCheckoutError();

    const nombre = (document.getElementById("cliente-nombre") as HTMLInputElement).value.trim();
    const email = (document.getElementById("cliente-email") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("cliente-telefono") as HTMLInputElement).value.trim();
    const direccion = (document.getElementById("cliente-direccion") as HTMLTextAreaElement).value.trim();
    const notas = (document.getElementById("cliente-notas") as HTMLTextAreaElement).value.trim();
    const zona = getSelectedZona();
    const pesoTotalGramos = getPesoTotalGramos();
    const calculo = calcularEnvio(zona, pesoTotalGramos);

    if (!nombre || !email || !telefono) {
      showCheckoutError("Completa tu nombre, email y teléfono para confirmar el pedido.");
      return;
    }
    if (zona !== "recogida" && !direccion) {
      showCheckoutError("Indica la dirección de envío o elige recogida en Elche.");
      return;
    }
    if (currentItems.length === 0) {
      showCheckoutError("Tu carrito está vacío.");
      return;
    }
    if (!calculo.ok) {
      showCheckoutError(
        "Tu pedido supera el peso que cubrimos con tarifa automática (2 kg). Contáctanos directamente para consultar el coste de envío antes de confirmar.",
      );
      return;
    }

    if (checkoutSubmit) {
      checkoutSubmit.disabled = true;
      checkoutSubmit.textContent = "Enviando...";
    }

    try {
      const pedidoId = crypto.randomUUID();
      const referencia = pedidoId.slice(0, 8).toUpperCase();

      const items = [];
      for (const item of currentItems) {
        const personalizacion: Record<string, unknown> = {};

        for (const [groupId, group] of Object.entries(item.personalization)) {
          const campos: Record<string, unknown> = {};

          for (const [fieldId, entry] of Object.entries(group.fields)) {
            if (entry.value instanceof File) {
              const path = `${pedidoId}/${item.id}-${groupId}-${fieldId}-${entry.value.name}`;
              const { error: uploadError } = await supabase.storage.from("fotos-pedidos").upload(path, entry.value);
              if (uploadError) throw new Error(`No se pudo subir la foto "${entry.value.name}": ${uploadError.message}`);
              campos[fieldId] = { label: entry.label, foto: path };
            } else {
              campos[fieldId] = { label: entry.label, valor: entry.value };
            }
          }

          personalizacion[groupId] = { label: group.groupLabel, campos };
        }

        items.push({
          producto_slug: item.productSlug,
          producto_nombre: item.productName,
          cantidad: 1,
          precio_unitario_cents: item.priceCents,
          personalizacion,
        });
      }

      const subtotalCents = currentItems.reduce((sum, item) => sum + item.priceCents, 0);
      const envioCents = calculo.priceCents;
      const totalCents = subtotalCents + envioCents;

      const { error: insertError } = await supabase.from("pedidos").insert({
        id: pedidoId,
        referencia,
        cliente_nombre: nombre,
        cliente_email: email,
        cliente_telefono: telefono || null,
        cliente_direccion: zona === "recogida" ? null : direccion,
        items,
        subtotal_cents: subtotalCents,
        zona_envio: zona,
        peso_total_gramos: pesoTotalGramos,
        envio_cents: envioCents,
        total_cents: totalCents,
        notas: notas || null,
      });

      if (insertError) throw new Error(insertError.message);

      if (checkoutSubmit) checkoutSubmit.textContent = "Redirigiendo al pago...";

      const pagoRes = await fetch("/api/crear-pago", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ pedidoId }),
      });
      const pagoData = await pagoRes.json();
      if (!pagoRes.ok || !pagoData.url) {
        throw new Error(pagoData.error || "No se pudo iniciar el pago. Tu pedido quedó guardado, contáctanos para coordinarlo.");
      }

      // Cart stays intact — it's only cleared once Stripe confirms the
      // payment on /pedido-confirmado, so a cancelled/abandoned payment
      // doesn't lose the customer's personalization work.
      window.location.href = pagoData.url;
    } catch (err) {
      showCheckoutError(err instanceof Error ? err.message : "No se pudo confirmar el pedido. Inténtalo de nuevo.");
    } finally {
      if (checkoutSubmit) {
        checkoutSubmit.disabled = false;
        checkoutSubmit.textContent = "Pagar ahora";
      }
    }
  });

  if (new URLSearchParams(window.location.search).get("pago") === "cancelado") {
    cancelNoticeEl?.classList.remove("hidden");
  }

  renderZonaOpciones();
  updateDireccionVisibility();
  loadCart();
</script>
