---
import Layout from "../../layouts/Layout.astro";
import { getProducts, formatPrice, type Product, type PersonalizationGroup, type PersonalizationField } from "../../data/products";
import { getCategory } from "../../data/categories";

interface Props {
  product: Product;
}

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = getCategory(product.category);

function fieldId(group: PersonalizationGroup, field: PersonalizationField) {
  return `${group.id}-${field.id}`;
}
---

<Layout title={product.name} description={product.shortDescription}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <a href="/productos" class="text-sm font-semibold text-hamy-coral hover:underline">&larr; Volver a productos</a>

    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <div class="flex aspect-square items-center justify-center rounded-3xl bg-gradient-to-br from-hamy-pink/15 via-hamy-coral/15 to-hamy-orange/15">
        <span class="text-9xl" aria-hidden="true">{product.emoji}</span>
      </div>

      <div>
        {category && <span class="text-xs font-semibold uppercase tracking-wide text-hamy-brown-light">{category.name}</span>}
        <h1 class="mt-1 font-heading text-4xl font-bold text-hamy-brown">{product.name}</h1>
        <p class="mt-2 text-2xl font-bold text-hamy-coral">{formatPrice(product.priceCents)}</p>
        <p class="mt-4 text-hamy-brown-light">{product.description}</p>

        <form
          id="personalization-form"
          class="mt-8 space-y-6"
          novalidate
          data-product-slug={product.slug}
          data-product-name={product.name}
          data-price-cents={product.priceCents}
          data-emoji={product.emoji}
        >
          {
            product.personalization.map((group) => (
              <fieldset class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
                <legend class="px-1 font-heading text-xl font-bold text-hamy-brown">{group.label}</legend>
                <div class="mt-3 space-y-4">
                  {group.fields.map((field) => {
                    const inputId = fieldId(group, field);
                    return (
                      <div
                        class="field"
                        data-group={group.id}
                        data-group-label={group.label}
                        data-field={field.id}
                        data-label={field.label}
                        data-field-required={field.required ? "true" : "false"}
                      >
                        <label for={inputId} class="block text-sm font-semibold text-hamy-brown">
                          {field.label}
                          {field.required && <span class="text-hamy-coral"> *</span>}
                        </label>
                        {field.helpText && <p class="mt-0.5 text-xs text-hamy-brown-light">{field.helpText}</p>}

                        {field.type === "text" && (
                          <input
                            id={inputId}
                            name={inputId}
                            type="text"
                            maxlength={field.maxLength}
                            placeholder={field.placeholder}
                            required={field.required}
                            class="mt-1.5 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-4 py-2.5 text-hamy-brown placeholder:text-hamy-brown-light/60 focus:border-hamy-coral focus:outline-none"
                          />
                        )}

                        {field.type === "date" && (
                          <input
                            id={inputId}
                            name={inputId}
                            type="date"
                            required={field.required}
                            class="mt-1.5 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-4 py-2.5 text-hamy-brown focus:border-hamy-coral focus:outline-none"
                          />
                        )}

                        {field.type === "number" && (
                          <input
                            id={inputId}
                            name={inputId}
                            type="number"
                            placeholder={field.placeholder}
                            required={field.required}
                            class="mt-1.5 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-4 py-2.5 text-hamy-brown focus:border-hamy-coral focus:outline-none"
                          />
                        )}

                        {field.type === "photo" && (
                          <div class="mt-1.5 flex items-center gap-4">
                            <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-hamy-cream-dark ring-1 ring-hamy-pink-light/30">
                              <img id={`${inputId}-preview`} class="hidden h-full w-full object-cover" alt="" />
                              <span id={`${inputId}-placeholder`} class="text-2xl" aria-hidden="true">
                                📷
                              </span>
                            </div>
                            <input
                              id={inputId}
                              name={inputId}
                              type="file"
                              accept="image/*"
                              required={field.required}
                              class="block w-full text-sm text-hamy-brown-light file:mr-3 file:rounded-full file:border-0 file:bg-hamy-coral file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-hamy-pink"
                            />
                          </div>
                        )}

                        <p id={`${inputId}-error`} class="mt-1 hidden text-xs font-semibold text-red-500">
                          Este campo es obligatorio.
                        </p>
                      </div>
                    );
                  })}
                </div>
              </fieldset>
            ))
          }

          <button type="submit" class="btn-primary w-full sm:w-auto">
            Añadir al carrito
          </button>
        </form>

        <div id="confirmation" class="mt-8 hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-hamy-pink-light/20">
          <p class="font-heading text-lg font-bold text-hamy-brown">✨ ¡Añadido al carrito!</p>
          <ul id="confirmation-summary" class="mt-3 space-y-1 text-sm text-hamy-brown-light"></ul>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="/carrito" class="btn-primary">Ver carrito</a>
            <a href="/productos" class="btn-secondary">Seguir comprando</a>
            <button type="button" id="add-another" class="text-sm font-semibold text-hamy-coral hover:underline">
              Personalizar otra unidad
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { addToCart, type CartItemPersonalization } from "../../lib/cart";

  const form = document.getElementById("personalization-form") as HTMLFormElement | null;
  const confirmation = document.getElementById("confirmation");
  const summaryList = document.getElementById("confirmation-summary");
  const addAnotherBtn = document.getElementById("add-another");

  function showError(input: HTMLInputElement) {
    input.classList.add("border-red-400");
    document.getElementById(`${input.id}-error`)?.classList.remove("hidden");
  }

  function clearError(input: HTMLInputElement) {
    input.classList.remove("border-red-400");
    document.getElementById(`${input.id}-error`)?.classList.add("hidden");
  }

  function validate(): boolean {
    if (!form) return false;
    let isValid = true;

    form.querySelectorAll<HTMLElement>("[data-field-required='true']").forEach((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>("input");
      if (!input) return;
      const filled = input.type === "file" ? !!input.files && input.files.length > 0 : input.value.trim() !== "";
      if (!filled) {
        isValid = false;
        showError(input);
      } else {
        clearError(input);
      }
    });

    form.querySelector<HTMLInputElement>(".border-red-400")?.focus();
    return isValid;
  }

  form?.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((input) => {
    input.addEventListener("change", () => {
      const file = input.files?.[0];
      const preview = document.getElementById(`${input.id}-preview`) as HTMLImageElement | null;
      const placeholder = document.getElementById(`${input.id}-placeholder`);
      clearError(input);
      if (!file || !preview) return;
      const reader = new FileReader();
      reader.onload = () => {
        preview.src = reader.result as string;
        preview.classList.remove("hidden");
        placeholder?.classList.add("hidden");
      };
      reader.readAsDataURL(file);
    });
  });

  form?.querySelectorAll<HTMLInputElement>('input[type="text"], input[type="date"], input[type="number"]').forEach((input) => {
    input.addEventListener("input", () => clearError(input));
  });

  function resetPreviews() {
    form?.querySelectorAll<HTMLImageElement>('img[id$="-preview"]').forEach((img) => {
      img.removeAttribute("src");
      img.classList.add("hidden");
    });
    form?.querySelectorAll<HTMLElement>('span[id$="-placeholder"]').forEach((span) => span.classList.remove("hidden"));
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validate() || !form) return;

    const personalization: CartItemPersonalization = {};
    form.querySelectorAll<HTMLElement>(".field").forEach((wrapper) => {
      const input = wrapper.querySelector<HTMLInputElement>("input");
      if (!input) return;
      const groupId = wrapper.dataset.group ?? "";
      const groupLabel = wrapper.dataset.groupLabel ?? "";
      const fieldId = wrapper.dataset.field ?? "";
      const fieldLabel = wrapper.dataset.label ?? "";
      const value = input.type === "file" ? input.files?.[0] ?? null : input.value.trim() || null;

      if (!personalization[groupId]) {
        personalization[groupId] = { groupLabel, fields: {} };
      }
      personalization[groupId].fields[fieldId] = { label: fieldLabel, value };
    });

    if (summaryList) {
      summaryList.innerHTML = "";
      form.querySelectorAll<HTMLElement>(".field").forEach((wrapper) => {
        const input = wrapper.querySelector<HTMLInputElement>("input");
        if (!input) return;
        const label = wrapper.dataset.label ?? "";
        const value = input.type === "file" ? input.files?.[0]?.name ?? "(sin foto)" : input.value.trim() || "(sin especificar)";
        const li = document.createElement("li");
        li.textContent = `${label}: ${value}`;
        summaryList.appendChild(li);
      });
    }

    await addToCart({
      productSlug: form.dataset.productSlug ?? "",
      productName: form.dataset.productName ?? "",
      priceCents: Number(form.dataset.priceCents ?? 0),
      emoji: form.dataset.emoji ?? "✨",
      personalization,
    });

    form.reset();
    resetPreviews();
    form.classList.add("hidden");
    confirmation?.classList.remove("hidden");
    confirmation?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  addAnotherBtn?.addEventListener("click", () => {
    confirmation?.classList.add("hidden");
    form?.classList.remove("hidden");
  });
</script>
