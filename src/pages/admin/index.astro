  const estadisticasLoading = document.getElementById("estadisticas-loading");
  const estadisticasError = document.getElementById("estadisticas-error");
  const estadisticasContent = document.getElementById("estadisticas-content");
  let estadisticasLoaded = false;
  let eventosCache: AnalyticsEvento[] = [];

  function startOf(daysAgo: number): number {
    const d = new Date();
    d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() - daysAgo);
    return d.getTime();
  }

  async function loadEstadisticas(force = false) {
    if (estadisticasLoaded && !force) return;
    estadisticasLoading?.classList.remove("hidden");
    estadisticasError?.classList.add("hidden");
    estadisticasContent?.classList.add("hidden");

    try {
      const eventos = await listAnalyticsRecientes();
      eventosCache = eventos;
      estadisticasLoaded = true;

      const inicioHoy = startOf(0);
      const inicioSemana = startOf(6);
      const inicioMes = startOf(29);

      let hoy = 0;
      let semana = 0;
      let mes = 0;
      const porProducto = new Map<string, number>();
      let duracionTotal = 0;
      let duracionCuenta = 0;

      for (const evento of eventos) {
        const ts = new Date(evento.creado_en).getTime();
        if (ts >= inicioMes) mes++;
        if (ts >= inicioSemana) semana++;
        if (ts >= inicioHoy) hoy++;

        if (evento.tipo === "producto_vista" && evento.producto_slug) {
          porProducto.set(evento.producto_slug, (porProducto.get(evento.producto_slug) ?? 0) + 1);
        }

        if (typeof evento.duracion_ms === "number") {
          duracionTotal += evento.duracion_ms;
          duracionCuenta++;
        }
      }

      const statHoy = document.getElementById("stat-hoy");
      const statSemana = document.getElementById("stat-semana");
      const statMes = document.getElementById("stat-mes");
      if (statHoy) statHoy.textContent = String(hoy);
      if (statSemana) statSemana.textContent = String(semana);
      if (statMes) statMes.textContent = String(mes);

      const topList = document.getElementById("stat-productos-top");
      const topEmpty = document.getElementById("stat-productos-vacio");
      if (topList) {
        topList.innerHTML = "";
        const ranking = [...porProducto.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);
        topEmpty?.classList.toggle("hidden", ranking.length > 0);
        ranking.forEach(([slug, count]) => {
          const nombre = productosCache.find((p) => p.slug === slug)?.nombre ?? slug;
          const li = document.createElement("li");
          li.className = "flex items-center justify-between gap-3";
          const nameSpan = document.createElement("span");
          nameSpan.textContent = nombre;
          const countSpan = document.createElement("span");
          countSpan.className = "font-semibold text-hamy-coral";
          countSpan.textContent = String(count);
          li.append(nameSpan, countSpan);
          topList.appendChild(li);
        });
      }

      const statDuracion = document.getElementById("stat-duracion");
      if (statDuracion) {
        if (duracionCuenta === 0) {
          statDuracion.textContent = "—";
        } else {
          const mediaSegundos = Math.round(duracionTotal / duracionCuenta / 1000);
          const mins = Math.floor(mediaSegundos / 60);
          const secs = mediaSegundos % 60;
          statDuracion.textContent = mins > 0 ? `${mins} min ${secs} s` : `${secs} s`;
        }
      }

      estadisticasContent?.classList.remove("hidden");
    } catch (err) {
      if (estadisticasError) {
        estadisticasError.textContent = err instanceof Error ? err.message : "No se pudieron cargar las estadísticas.";
        estadisticasError.classList.remove("hidden");
      }
    } finally {
      estadisticasLoading?.classList.add("hidden");
    }
  }

  function csvEscape(value: string): string {
    return /[",\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
  }

  function descargarCsvSemana() {
    const inicioSemana = startOf(6);
    const eventosSemana = eventosCache.filter((e) => new Date(e.creado_en).getTime() >= inicioSemana);

    const porProducto = new Map<string, number>();
    let duracionTotal = 0;
    let duracionCuenta = 0;
    for (const evento of eventosSemana) {
      if (evento.tipo === "producto_vista" && evento.producto_slug) {
        porProducto.set(evento.producto_slug, (porProducto.get(evento.producto_slug) ?? 0) + 1);
      }
      if (typeof evento.duracion_ms === "number") {
        duracionTotal += evento.duracion_ms;
        duracionCuenta++;
      }
    }
    const duracionMediaSegundos = duracionCuenta > 0 ? Math.round(duracionTotal / duracionCuenta / 1000) : 0;
    const ranking = [...porProducto.entries()].sort((a, b) => b[1] - a[1]);

    const lines: string[] = [];
    lines.push("Resumen semana actual");
    lines.push("Métrica,Valor");
    lines.push(`Visitas totales,${eventosSemana.length}`);
    lines.push(`Tiempo medio de estancia (segundos),${duracionMediaSegundos}`);
    lines.push("");
    lines.push("Productos más vistos,Visitas");
    if (ranking.length === 0) {
      lines.push("(sin visitas a productos esta semana),0");
    } else {
      for (const [slug, count] of ranking) {
        const nombre = productosCache.find((p) => p.slug === slug)?.nombre ?? slug;
        lines.push(`${csvEscape(nombre)},${count}`);
      }
    }

    const blob = new Blob([`﻿${lines.join("\n")}`], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `hamy-estadisticas-semana-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  document.getElementById("descargar-csv-btn")?.addEventListener("click", descargarCsvSemana);

