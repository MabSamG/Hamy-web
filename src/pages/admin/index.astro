  function ordenarYFiltrarClientes(): Cliente[] {
    const busqueda = (clientesBuscar?.value ?? "").trim().toLowerCase();
    let lista = clientesCache;
    if (busqueda) {
      lista = lista.filter(
        (c) => c.nombre.toLowerCase().includes(busqueda) || c.email.toLowerCase().includes(busqueda),
      );
    }
    const orden = clientesOrden?.value ?? "ultimo_pedido_desc";
    lista = [...lista].sort((a, b) => {
      if (orden === "total_gastado_desc") return b.totalGastadoCents - a.totalGastadoCents;
      if (orden === "ultimo_pedido_asc") {
        return new Date(a.ultimoPedidoEn).getTime() - new Date(b.ultimoPedidoEn).getTime();
      }
      return new Date(b.ultimoPedidoEn).getTime() - new Date(a.ultimoPedidoEn).getTime();
    });
    return lista;
  }

  function renderClientesList() {
    if (!clientesListEl) return;
    const lista = ordenarYFiltrarClientes();
    clientesListEl.innerHTML = "";
    clientesSinResultados?.classList.toggle("hidden", lista.length > 0 || clientesCache.length === 0);
    lista.forEach((cliente) => clientesListEl.appendChild(renderClienteRow(cliente)));
  }

  async function loadClientes() {
    if (clientesLoaded || !clientesListEl) return;
    clientesLoading?.classList.remove("hidden");
    clientesEmpty?.classList.add("hidden");
    try {
      clientesCache = await listClientes();
      clientesLoaded = true;
      clientesEmpty?.classList.toggle("hidden", clientesCache.length > 0);
      renderClientesList();
    } catch (err) {
      clientesListEl.innerHTML = "";
      const errorP = document.createElement("p");
      errorP.className = "text-sm font-semibold text-red-500";
      errorP.textContent = err instanceof Error ? err.message : "No se pudieron cargar los clientes.";
      clientesListEl.appendChild(errorP);
