  async function showClienteDetail(cliente: Cliente) {
    clienteSeleccionado = cliente;
    clientesListView?.classList.add("hidden");
    clientesDetailView?.classList.remove("hidden");

    const nombreEl = document.getElementById("cliente-detalle-nombre");
    const contactoEl = document.getElementById("cliente-detalle-contacto");
    const numPedidosEl = document.getElementById("cliente-detalle-numpedidos");
    const totalGastadoEl = document.getElementById("cliente-detalle-totalgastado");
    const ultimoPedidoEl = document.getElementById("cliente-detalle-ultimopedido");
    if (nombreEl) nombreEl.textContent = cliente.nombre;
    if (contactoEl) contactoEl.textContent = [cliente.email, cliente.telefono].filter(Boolean).join(" · ");
    if (numPedidosEl) numPedidosEl.textContent = String(cliente.numPedidos);
    if (totalGastadoEl) totalGastadoEl.textContent = formatPriceCents(cliente.totalGastadoCents);
    if (ultimoPedidoEl) ultimoPedidoEl.textContent = formatDate(cliente.ultimoPedidoEn);

    if (clientePedidosList) {
      clientePedidosList.innerHTML = "";
      cliente.pedidos.forEach((pedido) => clientePedidosList.appendChild(renderPedido(pedido)));
    }

    if (clienteNotasTextarea) {
      clienteNotasTextarea.value = "Cargando...";
      clienteNotasTextarea.disabled = true;
      clienteNotasError?.classList.add("hidden");
      try {
        clienteNotasTextarea.value = await getNotaCliente(cliente.clave);
      } catch (err) {
        clienteNotasTextarea.value = "";
        if (clienteNotasError) {
          clienteNotasError.textContent = err instanceof Error ? err.message : "No se pudo cargar la nota.";
          clienteNotasError.classList.remove("hidden");
        }
      } finally {
        clienteNotasTextarea.disabled = false;
      }
    }
  }

  clientesVolverBtn?.addEventListener("click", () => {
    clientesDetailView?.classList.add("hidden");
    clientesListView?.classList.remove("hidden");
    clienteSeleccionado = null;
  });

  clienteNotasGuardarBtn?.addEventListener("click", async () => {
    if (!clienteSeleccionado || !clienteNotasTextarea) return;
    clienteNotasGuardarBtn.disabled = true;
    clienteNotasError?.classList.add("hidden");
    try {
      await guardarNotaCliente(clienteSeleccionado.clave, clienteNotasTextarea.value);
      clienteNotasGuardado?.classList.remove("hidden");
      setTimeout(() => clienteNotasGuardado?.classList.add("hidden"), 2000);
    } catch (err) {
      if (clienteNotasError) {
        clienteNotasError.textContent = err instanceof Error ? err.message : "No se pudo guardar la nota.";
        clienteNotasError.classList.remove("hidden");
      }
    } finally {
      clienteNotasGuardarBtn.disabled = false;
    }
  });

