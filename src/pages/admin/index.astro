  function toggleNuevoProductoPanel(show: boolean) {
    nuevoProductoPanel?.classList.toggle("hidden", !show);
    nuevoProductoError?.classList.add("hidden");
    nuevoProductoSuccess?.classList.add("hidden");
    if (show) return;
    nuevoProductoForm?.reset();
    slugEditedManually = false;
    npCategoriaNuevaWrap?.classList.add("hidden");
  }

  nuevoProductoBtn?.addEventListener("click", () => toggleNuevoProductoPanel(true));
  nuevoProductoCancelar?.addEventListener("click", () => toggleNuevoProductoPanel(false));

  nuevoProductoForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    nuevoProductoError?.classList.add("hidden");
    nuevoProductoSuccess?.classList.add("hidden");

    const nombre = npNombre?.value.trim() ?? "";
    const slug = npSlug?.value.trim() ?? "";
    const categoriaSeleccionada = npCategoria?.value ?? "";
    const categoriaNuevaNombre = npCategoriaNueva?.value.trim() ?? "";
    const categoria = categoriaSeleccionada === "__nueva__" ? slugify(categoriaNuevaNombre) : categoriaSeleccionada;
    const categoriasRaw = (document.getElementById("np-categorias") as HTMLInputElement).value;
    const precio = (document.getElementById("np-precio") as HTMLInputElement).value;
    const stock = (document.getElementById("np-stock") as HTMLInputElement).value;
    const peso = (document.getElementById("np-peso") as HTMLInputElement).value;
    const emoji = (document.getElementById("np-emoji") as HTMLInputElement).value.trim();
    const plantillaId = (document.getElementById("np-plantilla") as HTMLSelectElement).value;
    const descCorta = (document.getElementById("np-desc-corta") as HTMLInputElement).value.trim();
    const descripcion = (document.getElementById("np-descripcion") as HTMLTextAreaElement).value.trim();
    const destacado = (document.getElementById("np-destacado") as HTMLInputElement).checked;

    if (categoriaSeleccionada === "__nueva__" && !categoriaNuevaNombre) {
      if (nuevoProductoError) {
        nuevoProductoError.textContent = "Escribe el nombre de la nueva categoría.";
        nuevoProductoError.classList.remove("hidden");
      }
      return;
    }

    if (!nombre || !slug || !categoria || !precio || !peso || !descCorta || !descripcion) {
      if (nuevoProductoError) {
        nuevoProductoError.textContent = "Completa los campos obligatorios (*).";
        nuevoProductoError.classList.remove("hidden");
      }
      return;
    }

    const plantilla = PERSONALIZATION_TEMPLATES.find((t) => t.id === plantillaId);
    const categorias = categoriasRaw
      .split(",")
      .map((c) => c.trim())
      .filter(Boolean);

    if (nuevoProductoSubmit) {
      nuevoProductoSubmit.disabled = true;
      nuevoProductoSubmit.textContent = "Guardando...";
    }

    try {
      const esCategoriaNueva = categoriaSeleccionada === "__nueva__";

      if (esCategoriaNueva) {
        const emojiNuevaCategoria = (document.getElementById("np-categoria-nueva-emoji") as HTMLInputElement).value.trim();
        await createCategoria({
          slug: categoria,
          nombre: categoriaNuevaNombre,
          emoji: emojiNuevaCategoria || undefined,
        });
      }

      await createProducto({
        slug,
        nombre,
        categoria,
        categorias: categorias.length ? categorias : [categoria],
        precio_base: Math.round(parseFloat(precio || "0") * 100),
        stock: stock === "" ? null : Number(stock),
        peso_gramos: Math.round(Number(peso || "0")),
        emoji: emoji || null,
        descripcion_corta: descCorta,
        descripcion,
        destacado,
        personalizacion: plantilla?.groups ?? [],
      });

      if (nuevoProductoSuccess) {
        nuevoProductoSuccess.textContent = esCategoriaNueva
          ? "Producto y categoría guardados. Aparecerán en la tienda pública después del próximo despliegue del sitio."
          : "Producto guardado. Aparecerá en la tienda pública después del próximo despliegue del sitio.";
        nuevoProductoSuccess.classList.remove("hidden");
      }
      nuevoProductoForm.reset();
      slugEditedManually = false;
      npCategoriaNuevaWrap?.classList.add("hidden");
      await loadProductos();
      if (esCategoriaNueva) await loadCategorias();
    } catch (err) {
      if (nuevoProductoError) {
        nuevoProductoError.textContent = err instanceof Error ? err.message : "No se pudo crear el producto.";
        nuevoProductoError.classList.remove("hidden");
      }
    } finally {
      if (nuevoProductoSubmit) {
        nuevoProductoSubmit.disabled = false;
        nuevoProductoSubmit.textContent = "Guardar y publicar";
      }
    }
  });

  let dashboardLoaded = false;

  supabase.auth.onAuthStateChange((event, session) => {
    if (session) {
      loginSection?.classList.add("hidden");
      dashboardSection?.classList.remove("hidden");
      if (!dashboardLoaded || event === "SIGNED_IN") {
        dashboardLoaded = true;
        loadPedidos();
        loadConsultasEventos();
        loadMensajesContacto();
        loadLeadsAgente();
        loadProductos();
        loadCategorias();
      }
    } else {
      dashboardLoaded = false;
      dashboardSection?.classList.add("hidden");
      loginSection?.classList.remove("hidden");
    }
  });

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    loginError?.classList.add("hidden");

    const email = (document.getElementById("login-email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("login-password") as HTMLInputElement).value;

    if (loginSubmit) {
      loginSubmit.disabled = true;
      loginSubmit.textContent = "Entrando...";
    }

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error && loginError) {
      loginError.textContent = "Email o contraseña incorrectos.";
      loginError.classList.remove("hidden");
    }

    if (loginSubmit) {
      loginSubmit.disabled = false;
      loginSubmit.textContent = "Entrar";
    }
  });

  logoutBtn?.addEventListener("click", async () => {
    await supabase.auth.signOut();
  });
</script>
