---
import Layout from "../../layouts/Layout.astro";
import { PERSONALIZATION_TEMPLATES } from "../../data/personalization";
---

<Layout title="Admin" description="Panel de administración de Hamy.">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div id="admin-login" class="mx-auto max-w-sm py-10">
      <div class="text-center">
        <span class="text-4xl" aria-hidden="true">🔐</span>
        <h1 class="mt-3 font-heading text-3xl font-bold text-hamy-brown">Acceso administrador</h1>
      </div>
      <form id="login-form" class="mt-6 space-y-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-hamy-pink-light/20" novalidate>
        <div>
          <label for="login-email" class="block text-sm font-semibold text-hamy-brown">Email</label>
          <input
            id="login-email"
            type="email"
            required
            class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
          />
        </div>
        <div>
          <label for="login-password" class="block text-sm font-semibold text-hamy-brown">Contraseña</label>
          <input
            id="login-password"
            type="password"
            required
            class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
          />
        </div>
        <p id="login-error" class="hidden text-sm font-semibold text-red-500"></p>
        <button type="submit" id="login-submit" class="btn-primary w-full justify-center">Entrar</button>
      </form>
    </div>

    <div id="admin-dashboard" class="hidden">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="font-heading text-3xl font-bold text-hamy-brown">Panel de administración</h1>
        <button type="button" id="logout-btn" class="btn-secondary">Cerrar sesión</button>
      </div>

      <div class="mt-6 flex gap-2 border-b border-hamy-pink-light/30">
        <button type="button" data-tab="pedidos" class="tab-btn border-b-2 border-hamy-coral px-4 py-2 text-sm font-semibold text-hamy-coral">
          Pedidos
        </button>
        <button
          type="button"
          data-tab="clientes"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Clientes
        </button>
        <button
          type="button"
          data-tab="eventos"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Eventos
        </button>
        <button
          type="button"
          data-tab="contacto"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Contacto
        </button>
        <button
          type="button"
          data-tab="agente"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Agente
        </button>
        <button
          type="button"
          data-tab="productos"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Catálogo
        </button>
        <button
          type="button"
          data-tab="estadisticas"
          class="tab-btn border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-hamy-brown-light"
        >
          Estadísticas
        </button>
      </div>

      <div id="tab-pedidos" class="tab-panel mt-6">
        <p id="pedidos-loading" class="text-hamy-brown-light">Cargando pedidos...</p>
        <p id="pedidos-empty" class="hidden text-hamy-brown-light">Todavía no hay pedidos.</p>
        <ul id="pedidos-list" class="space-y-4"></ul>
      </div>

      <div id="tab-clientes" class="tab-panel mt-6 hidden">
        <div id="clientes-list-view">
          <div class="flex flex-wrap items-center gap-3">
            <input
              id="clientes-buscar"
              type="search"
              placeholder="Buscar por nombre o email..."
              class="w-full max-w-xs rounded-full border-2 border-hamy-pink-light/40 bg-white px-4 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
            <select
              id="clientes-orden"
              class="rounded-full border-2 border-hamy-pink-light/40 bg-white px-4 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            >
              <option value="ultimo_pedido_desc">Último pedido: más reciente primero</option>
              <option value="ultimo_pedido_asc">Último pedido: más antiguo primero</option>
              <option value="total_gastado_desc">Total gastado: mayor a menor</option>
            </select>
          </div>
          <p id="clientes-loading" class="mt-4 text-hamy-brown-light">Cargando clientes...</p>
          <p id="clientes-empty" class="hidden mt-4 text-hamy-brown-light">Todavía no hay clientes.</p>
          <p id="clientes-sin-resultados" class="hidden mt-4 text-hamy-brown-light">Ningún cliente coincide con la búsqueda.</p>
          <ul id="clientes-list" class="mt-4 space-y-2"></ul>
        </div>

        <div id="clientes-detail-view" class="hidden">
          <button type="button" id="clientes-volver" class="text-sm font-semibold text-hamy-coral hover:underline">
            ← Volver a clientes
          </button>

          <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
            <h2 id="cliente-detalle-nombre" class="font-heading text-2xl font-bold text-hamy-brown"></h2>
            <p id="cliente-detalle-contacto" class="text-sm text-hamy-brown-light"></p>
            <div class="mt-4 grid grid-cols-3 gap-3 text-center">
              <div>
                <p id="cliente-detalle-numpedidos" class="font-heading text-2xl font-bold text-hamy-coral"></p>
                <p class="text-xs text-hamy-brown-light">Pedidos</p>
              </div>
              <div>
                <p id="cliente-detalle-totalgastado" class="font-heading text-2xl font-bold text-hamy-coral"></p>
                <p class="text-xs text-hamy-brown-light">Total gastado</p>
              </div>
              <div>
                <p id="cliente-detalle-ultimopedido" class="font-heading text-2xl font-bold text-hamy-coral"></p>
                <p class="text-xs text-hamy-brown-light">Último pedido</p>
              </div>
            </div>
          </div>

          <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
            <h3 class="font-heading text-lg font-bold text-hamy-brown">Notas</h3>
            <textarea
              id="cliente-notas"
              rows="4"
              placeholder="Observaciones sobre este cliente (ej. cliente habitual, siempre pide llavero de letra)..."
              class="mt-2 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            ></textarea>
            <div class="mt-2 flex items-center gap-3">
              <button type="button" id="cliente-notas-guardar" class="btn-primary">Guardar notas</button>
              <span id="cliente-notas-guardado" class="hidden text-sm font-semibold text-green-600">Guardado ✓</span>
              <span id="cliente-notas-error" class="hidden text-sm font-semibold text-red-500"></span>
            </div>
          </div>

          <h3 class="mt-6 font-heading text-lg font-bold text-hamy-brown">Historial de pedidos</h3>
          <ul id="cliente-pedidos-list" class="mt-3 space-y-4"></ul>
        </div>
      </div>

      <div id="tab-eventos" class="tab-panel mt-6 hidden">
        <p class="text-sm text-hamy-brown-light">
          Consultas de encargos por volumen (bodas, comuniones, etc.). No son pedidos confirmados — respóndelas para
          valorar viabilidad y presupuesto.
        </p>
        <p id="consultas-loading" class="mt-4 text-hamy-brown-light">Cargando consultas...</p>
        <p id="consultas-empty" class="hidden mt-4 text-hamy-brown-light">Todavía no hay consultas de eventos.</p>
        <ul id="consultas-list" class="mt-4 space-y-4"></ul>
      </div>

      <div id="tab-contacto" class="tab-panel mt-6 hidden">
        <p id="mensajes-loading" class="text-hamy-brown-light">Cargando mensajes...</p>
        <p id="mensajes-empty" class="hidden text-hamy-brown-light">Todavía no hay mensajes de contacto.</p>
        <ul id="mensajes-list" class="space-y-4"></ul>
      </div>

      <div id="tab-agente" class="tab-panel mt-6 hidden">
        <p class="text-sm text-hamy-brown-light">
          Contactos capturados por el agente virtual (widget de chat flotante) cuando un visitante deja su nombre y un
          email o teléfono.
        </p>
        <p id="leads-loading" class="mt-4 text-hamy-brown-light">Cargando contactos...</p>
        <p id="leads-empty" class="hidden mt-4 text-hamy-brown-light">Todavía no hay contactos del agente.</p>
        <ul id="leads-list" class="mt-4 space-y-4"></ul>
      </div>

      <div id="tab-productos" class="tab-panel mt-6 hidden">
        <div class="flex items-center justify-between gap-4">
          <p id="productos-loading" class="text-hamy-brown-light">Cargando catálogo...</p>
          <button type="button" id="nuevo-producto-btn" class="btn-primary ml-auto">+ Añadir producto</button>
        </div>

        <div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
          <h3 class="font-heading text-lg font-bold text-hamy-brown">Categorías</h3>
          <p class="text-xs text-hamy-brown-light">
            Borrar una categoría no borra los productos que la usan, pero dejarán de mostrar esa etiqueta y de aparecer en su filtro hasta que les asignes otra.
          </p>
          <ul id="categorias-list" class="mt-3 flex flex-wrap gap-2"></ul>
        </div>

        <div id="nuevo-producto-panel" class="mt-4 hidden rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
          <h3 class="font-heading text-lg font-bold text-hamy-brown">Nuevo producto</h3>
          <form id="nuevo-producto-form" class="mt-4 grid gap-3 sm:grid-cols-2" novalidate>
            <label class="block text-xs font-semibold text-hamy-brown">
              Nombre *
              <input
                id="np-nombre"
                type="text"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Slug (URL) *
              <input
                id="np-slug"
                type="text"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <p class="text-xs text-hamy-brown-light sm:col-span-2">
              El slug se genera solo a partir del nombre. Puedes editarlo antes de guardar, pero evita cambiarlo una vez publicado: es lo que conecta el producto con su página.
            </p>
            <label class="block text-xs font-semibold text-hamy-brown">
              Categoría principal *
              <select
                id="np-categoria"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              >
                <option value="" disabled selected>Cargando categorías...</option>
                <option value="__nueva__">+ Crear nueva categoría</option>
              </select>
            </label>
            <div id="np-categoria-nueva-wrap" class="hidden grid gap-3 sm:col-span-2 sm:grid-cols-[2fr_1fr]">
              <label class="block text-xs font-semibold text-hamy-brown">
                Nombre de la nueva categoría *
                <input
                  id="np-categoria-nueva"
                  type="text"
                  placeholder="Ej. Imanes"
                  class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
                />
              </label>
              <label class="block text-xs font-semibold text-hamy-brown">
                Emoji (opcional)
                <input
                  id="np-categoria-nueva-emoji"
                  type="text"
                  placeholder="🏷️"
                  class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
                />
              </label>
            </div>
            <label class="block text-xs font-semibold text-hamy-brown">
              Categorías (separadas por coma)
              <input
                id="np-categorias"
                type="text"
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Precio (€) *
              <input
                id="np-precio"
                type="number"
                step="0.01"
                min="0"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Stock (vacío = bajo pedido)
              <input
                id="np-stock"
                type="number"
                min="0"
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Peso (g) — para calcular el envío *
              <input
                id="np-peso"
                type="number"
                min="0"
                step="1"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Emoji
              <input
                id="np-emoji"
                type="text"
                placeholder="✨"
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown">
              Tipo de personalización *
              <select
                id="np-plantilla"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              >
                {PERSONALIZATION_TEMPLATES.map((template) => <option value={template.id}>{template.label}</option>)}
              </select>
            </label>
            <label class="block text-xs font-semibold text-hamy-brown sm:col-span-2">
              Descripción corta *
              <input
                id="np-desc-corta"
                type="text"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              />
            </label>
            <label class="block text-xs font-semibold text-hamy-brown sm:col-span-2">
              Descripción completa *
              <textarea
                id="np-descripcion"
                rows="3"
                required
                class="mt-1 w-full rounded-lg border-2 border-hamy-pink-light/40 bg-hamy-cream px-2 py-1.5 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
              ></textarea>
            </label>
            <label class="flex items-center gap-2 text-xs font-semibold text-hamy-brown sm:col-span-2">
              <input id="np-destacado" type="checkbox" />
              Destacado en Inicio
            </label>

            <p id="nuevo-producto-error" class="hidden text-sm font-semibold text-red-500 sm:col-span-2"></p>
            <p id="nuevo-producto-success" class="hidden text-sm font-semibold text-green-600 sm:col-span-2"></p>

            <div class="flex gap-3 sm:col-span-2">
              <button type="submit" id="nuevo-producto-submit" class="btn-primary">Guardar y publicar</button>
              <button type="button" id="nuevo-producto-cancelar" class="btn-secondary">Cancelar</button>
            </div>
          </form>
        </div>

        <ul id="productos-list" class="mt-6 space-y-4"></ul>
      </div>

      <div id="tab-estadisticas" class="tab-panel mt-6 hidden">
        <p id="estadisticas-loading" class="text-hamy-brown-light">Cargando estadísticas...</p>
        <p id="estadisticas-error" class="hidden text-sm font-semibold text-red-500"></p>

        <div id="estadisticas-content" class="hidden">
          <div class="flex justify-end">
            <button type="button" id="descargar-csv-btn" class="btn-secondary">⬇️ Descargar CSV de esta semana</button>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
              <p class="text-xs font-semibold uppercase tracking-wide text-hamy-brown-light">Visitas hoy</p>
              <p id="stat-hoy" class="mt-1 font-heading text-3xl font-bold text-hamy-coral">0</p>
            </div>
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
              <p class="text-xs font-semibold uppercase tracking-wide text-hamy-brown-light">Visitas esta semana</p>
              <p id="stat-semana" class="mt-1 font-heading text-3xl font-bold text-hamy-coral">0</p>
            </div>
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
              <p class="text-xs font-semibold uppercase tracking-wide text-hamy-brown-light">Visitas este mes</p>
              <p id="stat-mes" class="mt-1 font-heading text-3xl font-bold text-hamy-coral">0</p>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
              <h3 class="font-heading text-lg font-bold text-hamy-brown">Productos más vistos</h3>
              <p class="text-xs text-hamy-brown-light">Últimos 30 días</p>
              <ol id="stat-productos-top" class="mt-3 space-y-2 text-sm text-hamy-brown"></ol>
              <p id="stat-productos-vacio" class="hidden text-sm text-hamy-brown-light">Todavía no hay visitas a productos.</p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20">
              <h3 class="font-heading text-lg font-bold text-hamy-brown">Tiempo medio de estancia</h3>
              <p class="text-xs text-hamy-brown-light">Últimos 30 días</p>
              <p id="stat-duracion" class="mt-3 font-heading text-3xl font-bold text-hamy-coral">—</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";
  import {
    listPedidos,
    updatePedidoEstado,
    updatePedidoPagoEstado,
    getFotoUrl,
    listProductosAdmin,
    updateProducto,
    deleteProducto,
    createProducto,
    slugify,
    listAnalyticsRecientes,
    listCategoriasAdmin,
    createCategoria,
    deleteCategoria,
    listConsultasEventos,
    updateConsultaEventoAtendida,
    getFotoEventoUrl,
    listMensajesContacto,
    updateMensajeContactoAtendido,
    listLeadsAgente,
    updateLeadAgenteAtendido,
    listClientes,
    getNotaCliente,
    guardarNotaCliente,
    type Pedido,
    type PedidoEstado,
    type PagoEstado,
    type ProductoAdmin,
    type AnalyticsEvento,
    type CategoriaAdmin,
    type ConsultaEvento,
    type MensajeContacto,
    type LeadAgente,
    type Cliente,
  } from "../../lib/admin";
  import { zonaLabel } from "../../data/shipping";
  import { PERSONALIZATION_TEMPLATES } from "../../data/personalization";

  const loginSection = document.getElementById("admin-login");
  const dashboardSection = document.getElementById("admin-dashboard");
  const loginForm = document.getElementById("login-form") as HTMLFormElement | null;
  const loginError = document.getElementById("login-error");
  const loginSubmit = document.getElementById("login-submit") as HTMLButtonElement | null;
  const logoutBtn = document.getElementById("logout-btn");

  const pedidosList = document.getElementById("pedidos-list");
  const pedidosLoading = document.getElementById("pedidos-loading");
  const pedidosEmpty = document.getElementById("pedidos-empty");
  const productosList = document.getElementById("productos-list");
  const productosLoading = document.getElementById("productos-loading");

  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanels: Record<string, HTMLElement | null> = {
    pedidos: document.getElementById("tab-pedidos"),
    clientes: document.getElementById("tab-clientes"),
    eventos: document.getElementById("tab-eventos"),
    contacto: document.getElementById("tab-contacto"),
    agente: document.getElementById("tab-agente"),
    productos: document.getElementById("tab-productos"),
    estadisticas: document.getElementById("tab-estadisticas"),
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = btn.dataset.tab ?? "pedidos";
      tabButtons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle("border-hamy-coral", active);
        b.classList.toggle("text-hamy-coral", active);
        b.classList.toggle("border-transparent", !active);
        b.classList.toggle("text-hamy-brown-light", !active);
      });
      Object.entries(tabPanels).forEach(([key, panel]) => panel?.classList.toggle("hidden", key !== tab));
      if (tab === "estadisticas") loadEstadisticas();
      if (tab === "clientes") loadClientes();
    });
  });

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleString("es-ES", { dateStyle: "medium", timeStyle: "short" });
  }

  function formatPriceCents(cents: number): string {
    return (cents / 100).toLocaleString("es-ES", { style: "currency", currency: "EUR" });
  }

  const ESTADOS: { value: PedidoEstado; label: string }[] = [
    { value: "recibido", label: "Recibido" },
    { value: "preparando", label: "Preparando" },
    { value: "enviado", label: "Enviado" },
  ];

  const PAGO_ESTADOS: { value: PagoEstado; label: string }[] = [
    { value: "pendiente", label: "Pago pendiente" },
    { value: "pagado", label: "Pagado" },
  ];

  function renderPedido(pedido: Pedido): HTMLElement {
