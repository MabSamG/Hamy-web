      const enUso = productosCache.filter((p) => p.categoria === categoria.slug || p.categorias.includes(categoria.slug));
      const mensaje =
        enUso.length > 0
          ? `${enUso.length} producto(s) usan "${categoria.nombre}" (${enUso.map((p) => p.nombre).join(", ")}). Si la borras dejarán de mostrar esa etiqueta y de aparecer en ese filtro. ¿Borrar de todas formas?`
