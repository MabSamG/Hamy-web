---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../data/products";

const products = await getProducts();
---

<Layout
  title="Eventos"
  description="Encargos por volumen para comuniones, bodas, regalos de clase, despedidas de soltera y otros eventos."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="text-center">
      <h1 class="font-heading text-5xl font-bold text-hamy-brown">Eventos y encargos por volumen</h1>
      <p class="mt-4 text-hamy-brown-light">
        Preparamos encargos de varias unidades (a partir de 15 piezas) para comuniones, bodas, regalos de clase,
        despedidas de soltera y eventos similares. Cada pieza sigue haciéndose a mano, así que cuéntanos tu idea con
        tiempo para poder organizarla bien.
      </p>
    </div>

    <div class="mt-10 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-hamy-pink-light/20 sm:p-8">
      <h2 class="font-heading text-2xl font-bold text-hamy-brown">Cuéntanos tu encargo</h2>
      <p class="mt-2 text-sm text-hamy-brown-light">
        Esto es una <strong>consulta</strong>, no un pedido ni una reserva: al enviarla no se confirma ningún precio
        ni ninguna unidad. Te contactaremos para decirte si la pieza es posible, el precio por unidad y el precio
        total — a partir de ciertas cantidades aplicamos descuento por volumen.
      </p>

      <form id="eventos-form" class="mt-6 space-y-4" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="ev-nombre" class="block text-sm font-semibold text-hamy-brown">Nombre *</label>
            <input
              id="ev-nombre"
              type="text"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
          <div>
            <label for="ev-email" class="block text-sm font-semibold text-hamy-brown">Email *</label>
            <input
              id="ev-email"
              type="email"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="ev-telefono" class="block text-sm font-semibold text-hamy-brown">Teléfono *</label>
          <input
            id="ev-telefono"
            type="tel"
            required
            class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
          />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="ev-producto" class="block text-sm font-semibold text-hamy-brown">Producto de interés *</label>
            <select
              id="ev-producto"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            >
              <option value="" disabled selected>Selecciona una opción</option>
              {products.map((product) => <option value={product.name}>{product.name}</option>)}
              <option value="Otro / a medida">Otro / a medida</option>
            </select>
          </div>
          <div>
            <label for="ev-cantidad" class="block text-sm font-semibold text-hamy-brown">Cantidad *</label>
            <input
              id="ev-cantidad"
              type="number"
              min="15"
              step="1"
              required
              placeholder="Mínimo 15 unidades"
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="ev-fecha-evento" class="block text-sm font-semibold text-hamy-brown">Fecha del evento *</label>
            <input
              id="ev-fecha-evento"
              type="date"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
          <div>
            <label for="ev-fecha-entrega" class="block text-sm font-semibold text-hamy-brown">Fecha de entrega deseada *</label>
            <input
              id="ev-fecha-entrega"
              type="date"
              required
              class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="ev-imagen" class="block text-sm font-semibold text-hamy-brown">Imagen de referencia (opcional)</label>
          <input
            id="ev-imagen"
            type="file"
            accept="image/*"
            class="mt-1 block w-full text-sm text-hamy-brown-light file:mr-3 file:rounded-full file:border-0 file:bg-hamy-coral file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-hamy-pink"
          />
        </div>

        <div>
          <label for="ev-descripcion" class="block text-sm font-semibold text-hamy-brown">Descripción de lo que buscáis *</label>
          <textarea
            id="ev-descripcion"
            rows="4"
            required
            placeholder="Cuéntanos colores, estilo, si todas las piezas son iguales o personalizadas una a una, etc."
            class="mt-1 w-full rounded-xl border-2 border-hamy-pink-light/40 bg-hamy-cream px-3 py-2 text-sm text-hamy-brown focus:border-hamy-coral focus:outline-none"
          ></textarea>
        </div>

        <p id="eventos-error" class="hidden text-sm font-semibold text-red-500"></p>

        <button type="submit" id="eventos-submit" class="btn-primary w-full justify-center">Enviar consulta</button>
        <p class="text-xs text-hamy-brown-light">
          Al enviar esta consulta no se confirma ningún pedido, unidad ni precio. Te contactaremos para valorar la
          viabilidad y darte un presupuesto.
        </p>
      </form>

      <div id="eventos-success" class="hidden rounded-2xl bg-hamy-cream-dark p-6 text-center">
        <span class="text-4xl" aria-hidden="true">✨</span>
        <p class="mt-3 font-heading text-xl font-bold text-hamy-brown">¡Consulta enviada!</p>
        <p class="mt-2 text-sm text-hamy-brown-light">
          Nos puedas contactar en breve para hablar de la viabilidad, el precio por unidad y el precio total de tu
          encargo.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("eventos-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("eventos-error");
  const submitBtn = document.getElementById("eventos-submit") as HTMLButtonElement | null;
  const successEl = document.getElementById("eventos-success");

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");

    const nombre = (document.getElementById("ev-nombre") as HTMLInputElement).value.trim();
    const email = (document.getElementById("ev-email") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("ev-telefono") as HTMLInputElement).value.trim();
    const producto = (document.getElementById("ev-producto") as HTMLSelectElement).value;
    const cantidad = Number((document.getElementById("ev-cantidad") as HTMLInputElement).value);
    const fechaEvento = (document.getElementById("ev-fecha-evento") as HTMLInputElement).value;
    const fechaEntrega = (document.getElementById("ev-fecha-entrega") as HTMLInputElement).value;
    const descripcion = (document.getElementById("ev-descripcion") as HTMLTextAreaElement).value.trim();
    const imagenInput = document.getElementById("ev-imagen") as HTMLInputElement;
    const imagenFile = imagenInput.files?.[0] ?? null;

    if (!nombre || !email || !telefono || !producto || !fechaEvento || !fechaEntrega || !descripcion) {
      showError("Completa todos los campos obligatorios (*).");
      return;
    }
    if (!cantidad || cantidad < 15) {
      showError("El encargo mínimo por volumen es de 15 unidades.");
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
    }

    try {
      let imagenReferencia: string | null = null;
      if (imagenFile) {
        const path = `${crypto.randomUUID()}-${imagenFile.name}`;
        const { error: uploadError } = await supabase.storage.from("fotos-eventos").upload(path, imagenFile);
        if (uploadError) throw new Error(`No se pudo subir la imagen: ${uploadError.message}`);
        imagenReferencia = path;
      }

      const { error: insertError } = await supabase.from("consultas_eventos").insert({
        cliente_nombre: nombre,
        cliente_email: email,
        cliente_telefono: telefono,
        producto_interes: producto,
        cantidad,
        fecha_evento: fechaEvento,
        fecha_entrega_deseada: fechaEntrega,
        imagen_referencia: imagenReferencia,
        descripcion,
      });

      if (insertError) throw new Error(insertError.message);

      form.classList.add("hidden");
      successEl?.classList.remove("hidden");
      successEl?.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err) {
      showError(err instanceof Error ? err.message : "No se pudo enviar la consulta. Inténtalo de nuevo.");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar consulta";
      }
    }
  });
</script>
