---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "¿Cuánto tardan los envíos?",
    a: "Los pedidos se envían a toda España. El tiempo de entrega habitual es de 3 a 5 días laborables una vez la pieza está preparada.",
  },
  {
    q: "¿Cuánto tiempo tarda la personalización?",
    a: "Al ser piezas hechas a mano, la preparación de un pedido personalizado suele tardar entre 3 y 7 días laborables antes de enviarse, dependiendo de la complejidad y la cola de pedidos.",
  },
  {
    q: "¿Cómo debo cuidar mis piezas de resina?",
    a: "Evita la exposición directa y prolongada al sol para que no pierdan brillo, límpialas con un paño suave y ligeramente húmedo, y evita golpes o caídas ya que la resina, aunque resistente, puede llegar a agrietarse.",
  },
  {
    q: "¿Puedo pedir un diseño totalmente personalizado?",
    a: "Sí. Escríbenos por WhatsApp o desde el formulario de contacto contándonos tu idea y te diremos si es posible y el precio.",
  },
  {
    q: "¿Qué pasa si me equivoco al escribir el texto de personalización?",
    a: "Revisa bien los datos antes de confirmar el pedido. Si detectas un error, contáctanos cuanto antes por WhatsApp; si la pieza aún no se ha empezado, podremos corregirlo.",
  },
  {
    q: "¿Aceptáis devoluciones?",
    a: "Al tratarse de productos personalizados, no se aceptan devoluciones salvo defecto de fabricación. Consulta el detalle en nuestros Términos y condiciones.",
  },
];
---

<Layout title="Preguntas frecuentes" description="Resolvemos tus dudas sobre envíos, personalización y cuidado de nuestras piezas de resina.">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="text-center">
      <h1 class="font-heading text-5xl font-bold text-hamy-brown">Preguntas frecuentes</h1>
      <p class="mt-3 text-hamy-brown-light">Todo lo que necesitas saber sobre envíos, personalización y cuidados.</p>
    </div>

    <div class="mt-10 space-y-4">
      {
        faqs.map((item) => (
          <details class="group rounded-2xl bg-white p-5 shadow-sm ring-1 ring-hamy-pink-light/20 open:ring-hamy-coral/40">
            <summary class="flex cursor-pointer items-center justify-between font-heading text-lg font-bold text-hamy-brown">
              {item.q}
              <span class="ml-4 text-hamy-coral transition-transform group-open:rotate-45">＋</span>
            </summary>
            <p class="mt-3 text-sm text-hamy-brown-light">{item.a}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-hamy-brown-light">
      ¿No encuentras lo que buscas?
      <a href="/contacto" class="font-semibold text-hamy-coral hover:underline">Escríbenos</a>.
    </p>
  </section>
</Layout>
