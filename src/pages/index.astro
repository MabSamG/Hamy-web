---
import Layout from "../layouts/Layout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCategories } from "../data/categories";
import { getProducts } from "../data/products";

const categories = await getCategories();
const products = await getProducts();
const featuredProducts = products.filter((p) => p.featured);

const steps = [
  {
    title: "Elige tu pieza",
    text: "Explora el catálogo y elige el diseño que más te enamore.",
    emoji: "🛍️",
  },
  {
    title: "Personalízala",
    text: "Añade tu foto, nombre o fecha especial en el formulario del pedido.",
    emoji: "🎨",
  },
  {
    title: "La creamos a mano",
    text: "Preparamos tu pieza en resina, con mimo y con calma.",
    emoji: "🫧",
  },
  {
    title: "La recibes en casa",
    text: "Empaquetada con cariño y lista para regalar o guardar.",
    emoji: "📦",
  },
];

const trustBadges = [
  { emoji: "🤍", text: "Hecho a mano" },
  { emoji: "🚚", text: "Envíos a toda España" },
  { emoji: "✨", text: "Piezas personalizadas" },
  { emoji: "🔒", text: "Pago 100% seguro" },
];
---

<Layout title="Inicio">
  <!-- Hero -->
  <section class="relative isolate flex min-h-[90vh] flex-col overflow-hidden sm:min-h-screen">
    <img
      src="/inicio-hero.jpg"
      alt="Piezas de Hamy hechas a mano"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-hamy-pink/85 via-hamy-coral/70 to-hamy-orange/70"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto flex w-full max-w-6xl flex-1 items-center px-4 py-20 sm:px-6">
      <div class="max-w-xl [container-type:inline-size]">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-1.5 text-sm font-semibold text-hamy-coral shadow-sm">
          🤍 Hecho a mano con amor
        </span>
        <h1
          id="hero-title"
          class="mt-5 font-display text-5xl font-bold leading-tight text-white [text-shadow:0_2px_16px_rgb(107_66_38_/_0.45)] sm:text-6xl"
        >
          Recuerdos únicos en resina
        </h1>
        <p class="mt-5 max-w-md text-lg text-white/95 [text-shadow:0_1px_8px_rgb(107_66_38_/_0.4)]">
          Llaveros, marcapáginas, decoración y regalos personalizados creados a mano, pieza a pieza,
          para guardar tus momentos más especiales.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/productos" class="btn-primary">Ver productos</a>
          <a
            href="/quienes-somos"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-hamy-coral shadow-md transition-transform duration-200 hover:scale-[1.03]"
          >
            Conócenos
          </a>
        </div>
      </div>
    </div>

    <!-- Trust strip -->
    <div class="relative border-t border-white/20 bg-white/10 backdrop-blur-sm">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-4 px-4 py-6 sm:px-6 md:grid-cols-4">
        {
          trustBadges.map((badge) => (
            <div class="flex items-center justify-center gap-2 text-center text-sm font-semibold text-white [text-shadow:0_1px_6px_rgb(107_66_38_/_0.4)]">
              <span aria-hidden="true">{badge.emoji}</span>
              <span>{badge.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="font-heading text-4xl font-bold text-hamy-brown">Explora por categoría</h2>
      <p class="mt-3 text-hamy-brown-light">Encuentra la pieza perfecta para cada ocasión.</p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-4">
      {categories.map((category) => <CategoryCard category={category} />)}
    </div>
  </section>

  <!-- Productos destacados -->
  <section class="bg-hamy-cream-dark/60 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-heading text-4xl font-bold text-hamy-brown">Nuestros favoritos</h2>
          <p class="mt-3 text-hamy-brown-light">Los diseños que más enamoran a nuestros clientes.</p>
        </div>
        <a href="/productos" class="btn-secondary">Ver todo el catálogo</a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredProducts.map((product) => <ProductCard product={product} category={categories.find((c) => c.slug === product.category)} />)}
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="font-heading text-4xl font-bold text-hamy-brown">Cómo funciona</h2>
      <p class="mt-3 text-hamy-brown-light">De tu idea a tu casa, en cuatro sencillos pasos.</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
      {
        steps.map((step, i) => (
          <div class="relative rounded-3xl bg-white p-6 text-center shadow-sm ring-1 ring-hamy-pink-light/20">
            <span class="absolute -top-3 left-1/2 flex h-7 w-7 -translate-x-1/2 items-center justify-center rounded-full bg-gradient-hamy text-xs font-bold text-white shadow-md">
              {i + 1}
            </span>
            <span class="text-4xl" aria-hidden="true">{step.emoji}</span>
            <h3 class="mt-3 font-heading text-xl font-bold text-hamy-brown">{step.title}</h3>
            <p class="mt-2 text-sm text-hamy-brown-light">{step.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA final -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="flex flex-col items-center gap-5 rounded-[2.5rem] bg-gradient-hamy px-6 py-14 text-center shadow-xl shadow-hamy-coral/30">
      <h2 class="font-heading text-3xl font-bold text-white sm:text-4xl">¿Tienes una idea en mente?</h2>
      <p class="max-w-lg text-white/90">
        Creamos piezas a medida para regalos, eventos y momentos especiales. Cuéntanos qué imaginas.
      </p>
      <a
        href="/contacto"
        class="rounded-full bg-white px-6 py-3 font-semibold text-hamy-coral shadow-md transition-transform hover:scale-[1.03]"
      >
        Hablemos por WhatsApp
      </a>
    </div>
  </section>
</Layout>

<script>
  function fitHeroTitle() {
    const el = document.getElementById("hero-title");
    if (!el) return;

    const isDesktop = window.matchMedia("(min-width: 768px)").matches;
    el.style.whiteSpace = isDesktop ? "nowrap" : "";
    el.style.fontSize = "";
    if (!isDesktop) return;

    const minFontSize = 20;
    let fontSize = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > el.clientWidth && fontSize > minFontSize) {
      fontSize -= 1;
      el.style.fontSize = `${fontSize}px`;
    }
  }

  fitHeroTitle();
  window.addEventListener("resize", fitHeroTitle);
</script>
