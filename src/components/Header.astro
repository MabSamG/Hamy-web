---
import { getCategories } from "../data/categories";

const categories = await getCategories();

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Productos" },
  { href: "/eventos", label: "Eventos" },
  { href: "/quienes-somos", label: "Quiénes somos" },
  { href: "/faq", label: "FAQ" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-hamy-pink-light/30 bg-hamy-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center shrink-0">
      <img src="/logo.png" alt="Hamy" width="907" height="324" class="h-9 w-auto sm:h-10" />
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {
        navLinks.map((link) =>
          link.href === "/productos" ? (
            <div class="group relative">
              <a
                href={link.href}
                class:list={[
                  "flex items-center gap-1 text-sm font-semibold transition-colors hover:text-hamy-coral",
                  currentPath === link.href ? "text-hamy-coral" : "text-hamy-brown",
                ]}
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </a>
              <div class="invisible absolute left-1/2 top-full z-20 min-w-56 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="rounded-2xl bg-white p-2 shadow-lg ring-1 ring-hamy-pink-light/20">
                  <a href="/productos" class="block rounded-xl px-3 py-2 text-sm font-semibold text-hamy-brown hover:bg-hamy-cream-dark hover:text-hamy-coral">
                    Todos los productos
                  </a>
                  {categories.map((category) => (
                    <a
                      href={`/productos?categoria=${category.slug}`}
                      class="block rounded-xl px-3 py-2 text-sm text-hamy-brown hover:bg-hamy-cream-dark hover:text-hamy-coral"
                    >
                      {category.emoji} {category.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                "text-sm font-semibold transition-colors hover:text-hamy-coral",
                currentPath === link.href ? "text-hamy-coral" : "text-hamy-brown",
              ]}
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/carrito"
        class="relative flex h-10 w-10 items-center justify-center rounded-full border border-hamy-pink-light/50 text-hamy-brown transition-colors hover:border-hamy-coral hover:text-hamy-coral"
        aria-label="Ver carrito"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.972-4.694 2.545-7.162a1.125 1.125 0 00-1.11-1.337H5.106M7.5 14.25L5.106 5.288M7.5 14.25L5.25 21m12-6.75L19.5 21M9 21a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm9 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
        </svg>
        <span
          id="cart-badge"
          class="absolute -right-1 -top-1 hidden h-5 min-w-5 items-center justify-center rounded-full bg-hamy-coral px-1 text-[11px] font-bold text-white"
        >0</span>
      </a>

      <input type="checkbox" id="menu-toggle" class="peer hidden" />
      <label
        for="menu-toggle"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-hamy-brown md:hidden"
        aria-label="Abrir menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </label>

      <nav
        id="mobile-menu"
        class="fixed inset-x-0 top-[60px] hidden flex-col gap-1 border-b border-hamy-pink-light/30 bg-hamy-cream px-4 py-4 shadow-lg peer-checked:flex md:hidden"
      >
        {
          navLinks.map((link) => (
            <Fragment>
              <a
                href={link.href}
                class:list={[
                  "rounded-lg px-3 py-2.5 text-sm font-semibold",
                  currentPath === link.href ? "bg-hamy-cream-dark text-hamy-coral" : "text-hamy-brown",
                ]}
              >
                {link.label}
              </a>
              {link.href === "/productos" && (
                <div class="ml-3 flex flex-col gap-0.5 border-l-2 border-hamy-pink-light/30 pl-3">
                  {categories.map((category) => (
                    <a href={`/productos?categoria=${category.slug}`} class="rounded-lg px-3 py-2 text-sm text-hamy-brown-light hover:text-hamy-coral">
                      {category.emoji} {category.name}
                    </a>
                  ))}
                </div>
              )}
            </Fragment>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  import { getCartCount, CART_UPDATED_EVENT } from "../lib/cart";

  async function updateCartBadge() {
    const badge = document.getElementById("cart-badge");
    if (!badge) return;
    const count = await getCartCount();
    badge.textContent = String(count);
    badge.classList.toggle("hidden", count === 0);
    badge.classList.toggle("flex", count > 0);
  }

  updateCartBadge();
  window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);
</script>
