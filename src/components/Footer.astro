---
import { getCategories } from "../data/categories";

const categories = await getCategories();
const year = new Date().getFullYear();

const legalLinks = [
  { href: "/legal/aviso-legal", label: "Aviso legal" },
  { href: "/legal/privacidad", label: "Política de privacidad" },
  { href: "/legal/terminos", label: "Términos y condiciones" },
  { href: "/legal/cookies", label: "Política de cookies" },
];
---

<footer class="border-t border-hamy-pink-light/30 bg-hamy-cream-dark">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-1">
      <a href="/" class="flex items-center">
        <img src="/logo.png" alt="Hamy" width="907" height="324" class="h-10 w-auto" />
      </a>
      <p class="mt-3 text-sm text-hamy-brown-light">
        Artesanía y recuerdos únicos hechos a mano en resina, con todo el cariño.
      </p>
      <a
        href="https://wa.me/34600000000"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-hamy-coral hover:underline"
      >
        📱 Escríbenos por WhatsApp
      </a>
    </div>

    <div>
      <h3 class="font-heading text-xl font-bold text-hamy-brown">Navegación</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="hover:text-hamy-coral">Inicio</a></li>
        <li><a href="/quienes-somos" class="hover:text-hamy-coral">Quiénes somos</a></li>
        <li><a href="/productos" class="hover:text-hamy-coral">Productos</a></li>
        <li><a href="/faq" class="hover:text-hamy-coral">FAQ</a></li>
        <li><a href="/contacto" class="hover:text-hamy-coral">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-xl font-bold text-hamy-brown">Categorías</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {
          categories.map((cat) => (
            <li>
              <a href={`/productos?categoria=${cat.slug}`} class="hover:text-hamy-coral">
                {cat.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-xl font-bold text-hamy-brown">Legal</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-hamy-coral">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-hamy-pink-light/30 px-4 py-4 text-center text-xs text-hamy-brown-light sm:px-6">
    © {year} Hamy — Hecho a mano con amor. Todos los derechos reservados.
  </div>
</footer>
